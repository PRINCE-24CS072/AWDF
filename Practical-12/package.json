{
  "name": "practical-12-task-management",
  "version": "1.0.0",
  "description": "Task Management Application with JWT Authentication and Middleware Pipeline",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:jest": "jest --runInBand",
    "test:all": "jest --runInBand && node test_practical11.js",
    "test:practicals": "node test_practical9.js && node test_practical10.js && node test_practical11.js",
    "test:p9": "node test_practical9.js",
    "test:p10": "node test_practical10.js",
    "test:p11": "node test_practical11.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1"
  }
}
