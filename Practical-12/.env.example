PORT=5000
# Docker Compose orchestration (using Compose service name 'mongodb'):
MONGO_URI=mongodb://mongodb:27017/taskmanager
# Standalone local development (outside Docker):
# MONGO_URI=mongodb://localhost:27017/taskmanager
# MongoDB Atlas:
# MONGO_URI=your_mongodb_atlas_uri_here
JWT_SECRET=practical7_jwt_secret_key_2024
# Optional: In-memory cache toggle (set to false to benchmark uncached responses)
CACHE_ENABLED=true

